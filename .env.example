# Copy to .env.local for local builds, or set these in Vercel / GitHub (Settings → Variables).
# Every value is read at build time; leave a value empty to turn that feature off.

# Public address of the site, no trailing slash. Used for canonical/hreflang links,
# structured data, sitemap.xml and robots.txt.
# Empty: on Vercel the project's production domain, otherwise the GitHub Pages address.
VITE_SITE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = GA4 is not loaded.
VITE_GA4_ID=

# Meta (Facebook) Pixel ID. Empty = the pixel is not loaded.
VITE_META_PIXEL_ID=
